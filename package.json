{
  "name": "orbit-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "web": "npm run dev --workspace=orbit-web",
    "web:build": "npm run build --workspace=orbit-web",
    "mobile": "npm run start --workspace=orbit",
    "mobile:ios": "npm run ios --workspace=orbit",
    "mobile:android": "npm run android --workspace=orbit",
    "mobile:web": "npm run web --workspace=orbit"
  }
}
