# Copy this to fastlane/.env and fill in real values. fastlane/.env is
# gitignored — never commit it. Store the key files themselves outside this
# repo (e.g. ~/.appstore/) and point these paths at them.
#
# Reused as-is from GPN / Homeward / Diving Board — same Apple team
# (Black Road Health LLC) and same Google Play developer account.

# App Store Connect API key — confirmed live in App Store Connect →
# Users and Access → Integrations → Team Keys as "OrgHubs Apple API",
# App Manager access.
ASC_KEY_ID=8S29BQTU88
ASC_ISSUER_ID=2074fd35-7c5f-4e5f-b46b-4724eea01d25
ASC_KEY_PATH=/Users/sunil/.appstore/AuthKey_8S29BQTU88.p8

# --- Apple team ---------------------------------------------------------------
DEVELOPER_PORTAL_TEAM_ID=KGAU27H9W6   # Black Road Health LLC
ITC_TEAM_ID=                          # leave blank — the API key resolves it
APPLE_ID=mailcardozo@gmail.com        # fallback only, if the API key isn't used

# Google Play service account — same JSON file reused across every app, but
# you MUST grant it access to Orbit specifically first: Play Console →
# Setup → API access → find the service account → Manage Play Console
# permissions → grant it to this app.
PLAY_JSON_KEY_PATH=/Users/sunil/.appstore/play-service-account.json
