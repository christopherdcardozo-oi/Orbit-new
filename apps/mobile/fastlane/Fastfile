# Orbit — build & release pipeline.
#
# Adapted from the working Diving Board / GPN / Homeward Fastfiles (same
# Apple team, same release-pipeline lessons) — the one real difference is
# Orbit is an Expo/React Native app, not Capacitor: there's no static web
# build to sync, `ios/` and `android/` are gitignored, generated fresh from
# app.json + config plugins via `expo prebuild`, not committed.
#
# Required environment (put these in fastlane/.env, which is gitignored —
# see fastlane/.env.example for the full list and where to get each value):
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_PATH   — App Store Connect API key
#                                                (Users and Access → Keys)
#   PLAY_JSON_KEY_PATH                        — Google Play service account
#                                                JSON (Play Console → Setup →
#                                                API access) — must be
#                                                granted access to THIS app
#                                                specifically before first use
#
# Store the key files themselves OUTSIDE this repo (e.g. ~/.appstore/) and
# point the *_PATH vars at them — don't drop them inside fastlane/ even
# though .gitignore covers it there too.
#
# Lane naming follows fastlane convention: `beta` ships to TestFlight / the
# Play Internal Testing track — private, reversible, no review gate.
# `release` builds a production-track candidate and uploads it, but
# deliberately STOPS SHORT of the final public step: it does not submit for
# Apple review and it uploads to Play as a draft. Going fully live is a
# separate, human action — either you click Submit/Start rollout yourself in
# each console, or you explicitly ask for that as its own step. Don't add
# submit_for_review/release_status: 'completed' to automate that away; that's
# a one-way door and deserves its own explicit confirmation every time.

default_platform(:ios)
opt_out_usage

# Force a UTF-8 locale before anything shells out. Hit this for real on
# 2026-09-14: a non-interactive shell here had LANG/LC_ALL unset (defaulting
# to POSIX/"C"), and CocoaPods' `pod install` (which `expo prebuild` runs
# internally) crashed hard — Ruby's String#unicode_normalize raising
# Encoding::CompatibilityError trying to normalize the install path. Same
# root cause class as the xcpretty non-ASCII-byte crash the other apps'
# Fastfiles already guard against. Pinning it here means the pipeline carries
# its own fix rather than depending on whichever shell happens to invoke it.
#
# Only overrides a locale that isn't already UTF-8, so ja_JP.UTF-8 and
# friends are left alone while "", "C" and "POSIX" get corrected.
%w[LANG LC_ALL].each do |var|
  ENV[var] = 'en_US.UTF-8' unless ENV[var].to_s.upcase.include?('UTF-8')
end
Encoding.default_external = Encoding::UTF_8 unless Encoding.default_external == Encoding::UTF_8

# Point JAVA_HOME at a real JDK for the Android Gradle build — same fix as
# Diving Board's Fastfile. Gradle dies with "Unable to locate a Java Runtime"
# when JAVA_HOME is unset and no java is on PATH, which is the norm in a
# non-interactive shell even though an interactive login shell usually has it.
if ENV['JAVA_HOME'].to_s.empty? || !File.exist?(File.join(ENV['JAVA_HOME'].to_s, 'bin', 'java'))
  candidates = ['/Applications/Android Studio.app/Contents/jbr/Contents/Home']
  mac_java_home = `/usr/libexec/java_home 2>/dev/null`.strip
  candidates << mac_java_home unless mac_java_home.empty?
  found = candidates.find { |p| File.exist?(File.join(p, 'bin', 'java')) }
  ENV['JAVA_HOME'] = found if found
end

# Same story for ANDROID_HOME — set in ~/.zshrc for an interactive login shell,
# but absent from the non-interactive shell fastlane actually runs in here,
# which makes the Android Gradle plugin fail with "SDK location not found"
# even though the SDK is installed and this exact machine builds fine from
# a terminal. expo prebuild also needs it set to write android/local.properties.
if ENV['ANDROID_HOME'].to_s.empty? || !Dir.exist?(ENV['ANDROID_HOME'].to_s)
  candidate = File.join(Dir.home, 'Library/Android/sdk')
  if Dir.exist?(candidate)
    ENV['ANDROID_HOME'] = candidate
    ENV['ANDROID_SDK_ROOT'] = candidate
  end
end

APP_ID = 'com.orghubs.orbit'

# Regenerates ios/ and android/ from app.json + the Expo config plugins —
# the source of truth. NEVER hand-edit ios/ or android/ directly: they're
# gitignored and rebuilt fresh by this on every release. --clean wipes any
# stale native folder first, so a leftover build artifact from a previous
# run (or from `expo run:ios` during local dev) can't leak into a release
# build.
lane :prebuild do |options|
  Dir.chdir('..') do
    args = ['npx', 'expo', 'prebuild', '--clean']
    args += ['--platform', options[:platform]] if options[:platform]
    sh(*args)
  end
end

# Patches the release signingConfig into the FRESHLY generated
# android/app/build.gradle — every `prebuild` call above wipes and
# regenerates that file from Expo's default template (debug-signed only),
# so unlike Homeward (whose android/ is committed to git, signing config
# hand-edited in once) this has to re-apply on every single build instead
# of once. Reads real values from ~/.gradle/gradle.properties
# (ORBIT_UPLOAD_STORE_FILE etc — outside the repo, never touches git),
# same property-file mechanism Gradle already uses for Homeward/GOA.
# No-ops harmlessly if that file/property doesn't exist, so a machine
# without it still gets a debug-signed build instead of a hard failure.
def inject_android_signing
  path = 'android/app/build.gradle'
  path = "../#{path}" unless File.exist?(path)
  UI.user_error!('Could not find android/app/build.gradle to inject signing config') unless File.exist?(path)

  contents = File.read(path)

  # NOTE on indentation: written as explicit literal lines, not a squiggly
  # heredoc (<<~) — squiggly strips ALL common leading whitespace, which
  # flattened this to column 0 and produced ugly (though functionally
  # harmless) output the first time this was tested against a real
  # generated build.gradle.
  release_signing_config =
    "        release {\n" \
    "            if (project.hasProperty(\"ORBIT_UPLOAD_STORE_FILE\")) {\n" \
    "                storeFile file(ORBIT_UPLOAD_STORE_FILE)\n" \
    "                storePassword ORBIT_UPLOAD_STORE_PASSWORD\n" \
    "                keyAlias ORBIT_UPLOAD_KEY_ALIAS\n" \
    "                keyPassword ORBIT_UPLOAD_KEY_PASSWORD\n" \
    "            }\n" \
    "        }\n"

  # Insert the release signingConfig right after the default debug{} one,
  # inside the same signingConfigs {} block Expo's template always emits.
  unless contents.include?('ORBIT_UPLOAD_STORE_FILE')
    contents = contents.sub(
      /(    signingConfigs \{\n        debug \{[^}]*\}\n)/,
      "\\1#{release_signing_config}",
    )
  end

  # Point the release buildType at the new config when the property is
  # set, falling back to debug signing (Expo's own default) otherwise —
  # so a machine without the keystore still produces a working, just
  # not Play-uploadable, build rather than failing outright.
  #
  # Anchored on the Expo-template comment that ONLY appears directly above
  # buildTypes.release's signingConfig line — NOT a bare `release {` match.
  # First version of this used that bare match and it broke: once the
  # signingConfigs.release block above also contains the word "release",
  # a plain "release { ... signingConfig signingConfigs.debug" regex
  # matches the FIRST such occurrence in the file, which after insertion
  # is buildTypes.debug (which sits between the two "release" mentions),
  # not buildTypes.release — silently leaving the real release build
  # still debug-signed while corrupting the debug config instead. Caught
  # by testing against a real generated file before trusting this.
  contents = contents.sub(
    %r{(// Caution! In production, you need to generate your own keystore file\.\n\s*// see https://reactnative\.dev/docs/signed-apk-android\.\n\s*)signingConfig signingConfigs\.debug},
    "\\1signingConfig project.hasProperty(\"ORBIT_UPLOAD_STORE_FILE\") ? signingConfigs.release : signingConfigs.debug",
  )

  File.write(path, contents)
  UI.message('Injected Orbit release signingConfig into android/app/build.gradle')
end

# expo-notifications' config plugin and @react-native-firebase/messaging's own
# bundled AndroidManifest.xml both declare
# com.google.firebase.messaging.default_notification_color — ours pointing at
# our brand purple (@color/notification_icon_color, set via expo-notifications'
# `color` option in app.json), firebase-messaging's own pointing at its default
# (@color/white). The Android manifest merger treats that as a hard conflict
# and fails the release build:
#   "Attribute meta-data#...default_notification_color@resource value=(...)
#    is also present at [:react-native-firebase_messaging] ... value=(@color/white)
#    Suggestion: add 'tools:replace="android:resource"' to <meta-data> element"
#
# Tried doing this the "proper" way first — a local Expo config plugin using
# withAndroidManifest — but expo-notifications' own manifest mod runs AFTER
# a plugin listed later in app.json's plugins array (mod ordering isn't
# simply top-to-bottom), so ours ran first and found nothing to patch yet.
# Same pattern as inject_android_signing below: patch the plain-text
# generated file directly, right after prebuild, when it's guaranteed final.
def inject_manifest_merge_fix
  path = 'android/app/src/main/AndroidManifest.xml'
  path = "../#{path}" unless File.exist?(path)
  UI.user_error!('Could not find AndroidManifest.xml to patch manifest merge conflict') unless File.exist?(path)

  contents = File.read(path)
  target = '<meta-data android:name="com.google.firebase.messaging.default_notification_color" android:resource="@color/notification_icon_color"/>'
  replacement = '<meta-data android:name="com.google.firebase.messaging.default_notification_color" android:resource="@color/notification_icon_color" tools:replace="android:resource"/>'

  if contents.include?(target)
    File.write(path, contents.sub(target, replacement))
    UI.message('Patched AndroidManifest.xml to resolve firebase-messaging notification-color merge conflict')
  elsif contents.include?('tools:replace="android:resource"')
    UI.message('AndroidManifest.xml already patched for notification-color merge conflict')
  else
    UI.user_error!('Expected default_notification_color meta-data not found — expo-notifications output may have changed, update inject_manifest_merge_fix')
  end
end

def ios_api_key
  app_store_connect_api_key(
    key_id: ENV['ASC_KEY_ID'],
    issuer_id: ENV['ASC_ISSUER_ID'],
    key_filepath: ENV['ASC_KEY_PATH'],
  )
end

# Rewrite `versionCode N` in android/app/build.gradle. Dependency-free (no
# fastlane plugin) and cwd-agnostic — tries both relative locations since the
# lane body and the actions don't necessarily share a working directory.
def set_android_version_code(code)
  ['android/app/build.gradle', '../android/app/build.gradle'].each do |path|
    next unless File.exist?(path)
    File.write(path, File.read(path).sub(/versionCode\s+\d+/, "versionCode #{code}"))
    UI.message("Set Android versionCode to #{code}")
    return
  end
  UI.user_error!('Could not find android/app/build.gradle to set versionCode')
end

# Play requires version codes to be unique (and effectively increasing)
# across the WHOLE app, not per track — checking only 'internal' or only
# 'production' misses a higher code sitting on whichever track wasn't
# queried, and the upload gets rejected with "Version code N has already
# been used." This checks every track and returns the overall max, so the
# next code is always safely past all of them.
def latest_android_version_code
  %w[internal alpha beta production].map { |t|
    google_play_track_version_codes(track: t).first || 0
  }.max
end

platform :ios do
  desc 'Build and upload a new build to TestFlight'
  lane :beta do
    prebuild(platform: 'ios')
    ios_api_key
    next_build = latest_testflight_build_number + 1
    increment_build_number(build_number: next_build, xcodeproj: 'ios/Orbit.xcodeproj')
    build_app(
      workspace: 'ios/Orbit.xcworkspace',
      scheme: 'Orbit',
      export_method: 'app-store',
      export_options: { signingStyle: 'automatic' },
    )
    upload_to_testflight(skip_waiting_for_build_processing: true)
  end

  desc 'Build and upload a production-candidate build to App Store Connect. Does NOT submit for review — that click stays manual.'
  lane :release do
    prebuild(platform: 'ios')
    ios_api_key
    next_build = latest_testflight_build_number + 1
    increment_build_number(build_number: next_build, xcodeproj: 'ios/Orbit.xcodeproj')
    build_app(
      workspace: 'ios/Orbit.xcworkspace',
      scheme: 'Orbit',
      export_method: 'app-store',
      export_options: { signingStyle: 'automatic' },
    )
    upload_to_app_store(
      submit_for_review: false,  # deliberate — see file header
      automatic_release: false,
      skip_metadata: true,       # listing text/screenshots are already set in App Store Connect
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
    )
  end
end

platform :android do
  desc 'Build a release .aab locally without uploading — for the mandatory manual first Play Console release (Google rejects a new app\'s first release via API), or any time you just want the artifact. versionCode defaults to 1 since latest_android_version_code queries existing Play tracks, which don\'t exist yet for a brand-new app; pass version_code: N to override.'
  lane :build do |options|
    prebuild(platform: 'android')
    inject_manifest_merge_fix
    inject_android_signing
    set_android_version_code(options[:version_code] || 1)
    gradle(task: 'bundle', build_type: 'Release', project_dir: 'android/')
    UI.success("Built android/app/build/outputs/bundle/release/app-release.aab — upload it manually in Play Console.")
  end

  desc 'Build and upload a new build to the Play Console Internal Testing track'
  lane :beta do
    prebuild(platform: 'android')
    inject_manifest_merge_fix
    inject_android_signing
    # NOTE: a brand-new app's very first-ever Play Console upload must be a
    # manual drag-and-drop in the Play Console UI — Google's API rejects the
    # first release for a new app. Once that's done once, this lane works
    # normally for every upload after.
    set_android_version_code(latest_android_version_code + 1)
    gradle(task: 'bundle', build_type: 'Release', project_dir: 'android/')
    upload_to_play_store(
      track: 'internal',
      aab: 'android/app/build/outputs/bundle/release/app-release.aab',
      # supply scans the output directory and refuses to run if it finds
      # both an .aab and an .apk. Any earlier assembleRelease leaves an
      # .apk behind, so be explicit rather than depending on a clean dir.
      skip_upload_apk: true,
    )
  end

  desc 'Build and upload a production-candidate build to the Play Console, staged as a draft. Does NOT start the rollout — that click stays manual.'
  lane :release do
    prebuild(platform: 'android')
    inject_manifest_merge_fix
    inject_android_signing
    set_android_version_code(latest_android_version_code + 1)
    gradle(task: 'bundle', build_type: 'Release', project_dir: 'android/')
    upload_to_play_store(
      track: 'production',
      aab: 'android/app/build/outputs/bundle/release/app-release.aab',
      skip_upload_apk: true,
      release_status: 'draft',  # deliberate — see file header
    )
  end
end
